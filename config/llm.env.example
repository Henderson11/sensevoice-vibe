# ============================================================
# SenseVoice Vibe 配置（复制到 ~/.config/sensevoice-vibe/llm.env，权限 600）
#   install.sh 会自动复制并把 __INSTALL_DIR__ 换成安装路径。
#   改完重启生效：systemctl --user restart sensevoice-vibe
#   切换识别模型用 ./switch_asr.sh message|standard（会改本文件并重启）
# ============================================================

# === 语音识别：阿里云百炼 ===
SENSEVOICE_BAILIAN_API_KEY=<YOUR_DASHSCOPE_API_KEY>
# 主模型：qwen-audio-3.1-asr-flash-message（WebSocket，带前文上下文，需 dashscope SDK）
#        或 qwen-audio-3.1-asr-flash（HTTP，更便宜）
SENSEVOICE_BAILIAN_MODEL=qwen-audio-3.1-asr-flash-message
# 主模型慢了（超过 HEDGE_AFTER）就并发发给这些备用模型，谁先成功用谁
SENSEVOICE_BAILIAN_HEDGE_MODELS=qwen-audio-3.1-asr-flash,fun-asr-flash-2026-06-15
SENSEVOICE_BAILIAN_HEDGE_AFTER_MS=2500        # 实际取 max(此值, 音频时长×HEDGE_AFTER_RATIO)
SENSEVOICE_BAILIAN_HEDGE_AFTER_RATIO=0.1
SENSEVOICE_BAILIAN_TIMEOUT_SEC=15             # 实际取 max(此值, 音频时长×TIMEOUT_RATIO)
SENSEVOICE_BAILIAN_TIMEOUT_RATIO=0.35
SENSEVOICE_BAILIAN_WORKSPACE=                 # 百炼工作空间 ID（仅 -message 用）；空=旧共享网关
SENSEVOICE_BAILIAN_CONTEXT_TURNS=3            # -message 前文：带最近几句已输入的话，0=不带
SENSEVOICE_BAILIAN_CONTEXT_MAX_CHARS=300
# 热词表：默认读仓库的 config/hotwords.yaml（不入库，见 README）；可用此项指向别的文件
# SENSEVOICE_ASR_CONTEXT_FILE=

# === 收音与分段（webrtcvad）===
SENSEVOICE_STREAM_ACTIVE_ON_START=1           # daemon 启动即开始收音（F8 开关）
SENSEVOICE_STREAM_ENDPOINT_MS=1500            # 静音多久算说完（ms）
SENSEVOICE_STREAM_MAX_SEGMENT_MS=180000       # 单段上限（ms）
SENSEVOICE_STREAM_SOFT_CUT_WINDOW_MS=20000    # 上限前这段时间内遇到短停顿就收尾，0=关闭
SENSEVOICE_STREAM_SOFT_CUT_SILENCE_MS=300
SENSEVOICE_STREAM_MIN_SEGMENT_MS=400          # 短于此丢弃
SENSEVOICE_STREAM_VAD_AGGRESSIVENESS=2        # 0~3，越大越容易判为静音
SENSEVOICE_STREAM_START_MS=240
SENSEVOICE_STREAM_FRAME_MS=20
SENSEVOICE_STREAM_PRE_ROLL_MS=700             # 起点向前回看，避免吃掉第一个字
# SENSEVOICE_ARECORD_DEVICE=                  # arecord -D 设备名；空=系统默认麦克风

# === 声纹门禁（只识别注册过的本人）===
SENSEVOICE_SPK_ENABLE=1
SENSEVOICE_SPK_THRESHOLD=0.50                 # ERes2NetV2 余弦相似度阈值
SENSEVOICE_SPK_MIN_MS=900
SENSEVOICE_SPK_ENROLL_WAV=$HOME/.local/state/sensevoice-vibe/speaker_enroll.d
SENSEVOICE_SPK_MODEL=__INSTALL_DIR__/models/eres2netv2
SENSEVOICE_SPK_CACHE_DIR=__INSTALL_DIR__/models/eres2netv2
SENSEVOICE_SPK_AGG=topk_mean
SENSEVOICE_SPK_TOPK=1
SENSEVOICE_SPK_ADAPTIVE=1
SENSEVOICE_SPK_PRUNE_OUTLIERS=1
SENSEVOICE_SPK_AUTO_ENROLL=0
SENSEVOICE_SPK_WINDOW_MS=5000                 # 说话过程中每满 5s 后台算一窗；0=说完再整段判定
SENSEVOICE_SPK_WINDOW_GRAY=0.08               # 分窗均值落在 [阈值-此值, 阈值) 时回退整段判定

# === 没出字兜底（最近语音备份 / 通知重试 / Shift+F8 面板）===
SENSEVOICE_RECENT_ENABLE=1
SENSEVOICE_RECENT_MAX=50
SENSEVOICE_RECENT_MAX_OK=20                   # 正常输入的只留最近这么多条
SENSEVOICE_RECENT_DAYS=3
SENSEVOICE_RECENT_SPK_MIN_SCORE=0.40          # 声纹被拒但不低于此分数的才存（更低的几乎都是旁人）
# 声纹被拒的段默认只静默备份（Shift+F8 查看）；只有某一窗明确像本人（多半是混入了旁人声音）才提醒，
# 且是低优先级通知（GNOME 不弹横幅，只进通知列表，可点"重新识别并输入"），冷却期内最多一次
SENSEVOICE_RECENT_NOTIFY_MIN_MS=5000
SENSEVOICE_RECENT_NOTIFY_WIN_SCORE=0.60       # 本人语音的最高窗一般 ≥0.60，旁人近失段 ≤0.56
SENSEVOICE_RECENT_NOTIFY_COOLDOWN_SEC=600

# === LLM 润色（OpenAI 兼容 API）===
SENSEVOICE_POST_LLM_ENABLE=1
SENSEVOICE_POST_LLM_BASE_URL=<YOUR_LLM_BASE_URL>
SENSEVOICE_POST_LLM_API_KEY=<YOUR_LLM_API_KEY>
SENSEVOICE_POST_LLM_MODEL=<YOUR_LLM_MODEL>
# 主链路失败时立即改用的备用（例：百炼兼容模式 + qwen-flash）
SENSEVOICE_POST_LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SENSEVOICE_POST_LLM_FALLBACK_API_KEY=<YOUR_DASHSCOPE_API_KEY>
SENSEVOICE_POST_LLM_FALLBACK_MODEL=qwen-flash
# pyramid：按金字塔原理重组（结论先行、归类分组），较长的话附带一句表达建议；polish_coding_aggressive：按原话顺序纠错
# 也可用 ./switch_polish.sh pyramid|faithful 切换
SENSEVOICE_POST_LLM_MODE=pyramid
SENSEVOICE_POST_LLM_PYRAMID_MIN_CHARS=40            # 短于此只纠错不重组
SENSEVOICE_EXPRESSION_TIPS=0                        # 表达建议默认只记入表达日志，Shift+F8 →"表达复盘"查看；1=每条另发低优先级通知
SENSEVOICE_EXPRESSION_TIP_COOLDOWN_SEC=300
SENSEVOICE_POST_LLM_TIMEOUT_MS=1800                 # 长文本按字数自动放宽
SENSEVOICE_POST_LLM_MAX_TOKENS=96                   # 防扩写上限；长段自动按原文长度放大
SENSEVOICE_POST_LLM_DYNAMIC_MAX_TOKENS=0
SENSEVOICE_POST_LLM_TEMPERATURE=0
SENSEVOICE_POST_LLM_MIN_CHARS=5
SENSEVOICE_POST_LLM_STRICT=0                        # 1=润色失败就不输入（默认输入原文）
SENSEVOICE_POST_LLM_CIRCUIT_MAX_FAILS=4
SENSEVOICE_POST_LLM_CIRCUIT_COOLDOWN_SEC=25
SENSEVOICE_POST_LLM_HARD_COOLDOWN_SEC=300
SENSEVOICE_POST_LLM_RETRY_ON_TIMEOUT=1

# === 项目术语表（从代码目录提取标识符，作润色的术语提示）===
SENSEVOICE_PROJECT_LEXICON_ENABLE=1
SENSEVOICE_PROJECT_ROOT=$HOME                 # 设为常用的代码工作目录
SENSEVOICE_PROJECT_LEXICON_MAX_TERMS=2500
SENSEVOICE_PROJECT_LEXICON_HINT_LIMIT=16
SENSEVOICE_PROJECT_LEXICON_MIN_TERM_LEN=3

# === 文本与日志 ===
SENSEVOICE_LANGUAGE=auto
SENSEVOICE_FILTER_FILLERS=1                   # 丢掉只有"嗯/啊"的片段和英文语气词
SENSEVOICE_COMPARE_LOG_ENABLE=1               # 逐段记录 post_compare.jsonl（识别原文/润色/结果）
SENSEVOICE_COMPARE_LOG_KEEP_LINES=300
SENSEVOICE_RETENTION_KEEP_RECENT=20           # 启动前清理：状态目录里的散落 wav 只留最新这么多
SENSEVOICE_LOG_KEEP_LINES=120                 # 启动前清理：日志只留最后这么多行
SENSEVOICE_INJECT_ACK_TIMEOUT_SEC=1.2
