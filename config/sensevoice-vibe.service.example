[Unit]
Description=SenseVoice Vibe voice input daemon
After=default.target
# 5 分钟内最多重启 5 次失败才放弃；启动慢时不至于被熔断
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# 安装路径由 install_autostart_service.sh 自动填入
WorkingDirectory=__INSTALL_DIR__
Environment=PYTHONPATH=__INSTALL_DIR__
# 启动前清理状态目录里的旧日志与旧 wav（不碰声纹模板与 recent_audio）
ExecStartPre=/bin/bash __INSTALL_DIR__/retention_housekeep.sh
# 配置统一在 ~/.config/sensevoice-vibe/llm.env，由 daemon_launch.sh 用 bash source（EnvironmentFile 不展开 $HOME）
ExecStart=__INSTALL_DIR__/daemon_launch.sh
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=default.target
