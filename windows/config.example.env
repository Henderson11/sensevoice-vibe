# WinVoice 配置（部署脚本会从 Linux 的 llm.env 生成真正的 config.env，里面含 API Key，不要入库）

# --- 热键 / 注入 / 麦克风 ---
WINVOICE_HOTKEY=DOUBLETAP:CTRL      # 双击 Ctrl 开关（左右 Ctrl 均可）。也可 TAP:RCTRL(单击右Ctrl) / TAP:RALT / CTRL+ALT+H(组合键,走RegisterHotKey)
WINVOICE_INJECT_MODE=type          # type=逐字符 Unicode 键盘事件(默认)  paste=剪贴板+Ctrl+V(备选)
WINVOICE_INPUT_DEVICE=             # 空=系统默认；可填设备序号或名称片段(见 --list-devices)

# --- 云端 ASR（百炼）---
SENSEVOICE_BAILIAN_API_KEY=
SENSEVOICE_BAILIAN_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
SENSEVOICE_BAILIAN_MODEL=qwen-audio-3.0-asr-flash

# --- 断句 ---
SENSEVOICE_STREAM_ENDPOINT_MS=1500
SENSEVOICE_STREAM_MAX_SEGMENT_MS=30000
SENSEVOICE_STREAM_MIN_SEGMENT_MS=400
SENSEVOICE_STREAM_VAD_AGGRESSIVENESS=2

# --- LLM 润色（内网网关为主，百炼云端 qwen-flash 兜底）---
SENSEVOICE_POST_LLM_ENABLE=1
